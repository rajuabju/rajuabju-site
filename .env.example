# Copy this file to .env.local for local dev, and add the same variables
# in Vercel: Project Settings -> Environment Variables.

# API key from https://www.smtp2go.com (Sending -> API Keys). rajuabju.com
# must be a Verified Sender domain in SMTP2GO (Sending -> Verified Senders)
# with its SPF/DKIM/return-path CNAME records added at your DNS host.
SMTP2GO_API_KEY=

# The inbox that should receive contact form submissions.
# This is never exposed to site visitors — it only lives on the server.
CONTACT_TO_EMAIL=

# Cloudflare Turnstile (free) — https://dash.cloudflare.com/?to=/:account/turnstile
# Site key is PUBLIC (shipped to the browser) — must be prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key is PRIVATE — server-side only, never expose this one.
TURNSTILE_SECRET_KEY=
