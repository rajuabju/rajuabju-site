# Copy this file to .env.local for local dev. In production these live in
# Cloudflare: Workers & Pages -> rajuabju-site -> Settings -> Variables and Secrets.

# API key from https://www.smtp2go.com (Sending -> API Keys). rajuabju.com
# must be a Verified Sender domain in SMTP2GO (Sending -> Verified Senders)
# with its SPF/DKIM/return-path CNAME records added in Cloudflare DNS.
SMTP2GO_API_KEY=

# The inbox that should receive contact form submissions.
# This is never exposed to site visitors; it only lives on the server.
CONTACT_TO_EMAIL=

# Cloudflare Turnstile (free): https://dash.cloudflare.com/?to=/:account/turnstile
# Site key is PUBLIC (baked into the page at build time); must be prefixed NEXT_PUBLIC_.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key is PRIVATE: used only by the Pages Function, never expose this one.
TURNSTILE_SECRET_KEY=
